+template <typename T>
+__device__ __forceinline__ uint32_t __cvta_generic_to_shared(T *ptr) {
+    size_t smem_addr;
+    asm volatile(
+        "cvta.to.shared.u64 %0, %1;"
+        : "=l"(smem_addr)
+        : "l"(ptr));
+    return static_cast<uint32_t>(smem_addr);
